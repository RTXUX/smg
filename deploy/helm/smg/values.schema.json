{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "router": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "enum": [
            "cache_aware",
            "round_robin",
            "power_of_two",
            "manual",
            "random",
            "prefix_hash"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "service": {
          "type": "object",
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "metrics": {
          "type": "object",
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "autoscaling": {
          "type": "object",
          "properties": {
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "targetCPUUtilizationPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "rateLimitTokensPerSecond": {
          "type": "integer"
        },
        "apiKey": {
          "$ref": "#/definitions/sensitiveValue"
        },
        "controlPlaneApiKeys": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "role",
              "key"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^:]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^:]+$"
              },
              "role": {
                "enum": [
                  "admin",
                  "user"
                ]
              },
              "key": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "$ref": "#/definitions/sensitiveValue"
                  }
                ]
              }
            }
          }
        }
      }
    },
    "history": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string",
          "enum": [
            "none",
            "memory",
            "postgres",
            "redis",
            "oracle"
          ]
        },
        "postgres": {
          "type": "object",
          "properties": {
            "poolMax": {
              "type": "integer",
              "minimum": 1
            },
            "url": {
              "$ref": "#/definitions/sensitiveValue"
            },
            "username": {
              "$ref": "#/definitions/sensitiveValue"
            },
            "password": {
              "$ref": "#/definitions/sensitiveValue"
            },
            "host": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "database": {
              "type": "string"
            },
            "parameters": {
              "type": "string"
            }
          }
        },
        "redis": {
          "type": "object",
          "properties": {
            "poolMax": {
              "type": "integer",
              "minimum": 1
            },
            "url": {
              "$ref": "#/definitions/sensitiveValue"
            }
          }
        },
        "oracle": {
          "type": "object",
          "properties": {
            "poolMax": {
              "type": "integer",
              "minimum": 1
            },
            "dsn": {
              "$ref": "#/definitions/sensitiveValue"
            },
            "user": {
              "$ref": "#/definitions/sensitiveValue"
            },
            "password": {
              "$ref": "#/definitions/sensitiveValue"
            }
          }
        }
      }
    },
    "huggingface": {
      "type": "object",
      "properties": {
        "token": {
          "$ref": "#/definitions/sensitiveValue"
        }
      }
    }
  },
  "definitions": {
    "sensitiveValue": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "secretKeyRef"
          ],
          "additionalProperties": false,
          "properties": {
            "secretKeyRef": {
              "type": "object",
              "required": [
                "name",
                "key"
              ],
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
